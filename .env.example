# Copy to .env for local use. Do not commit .env or credential files.

# Google Sheets service-account JSON file
GOOGLE_SHEETS_CREDENTIALS=/absolute/path/to/google-sheets-service-account.json

# Google Sheet URLs used by the lead and outreach workflows
LEAD_RESEARCH_SHEET_URL=https://docs.google.com/spreadsheets/d/REPLACE_ME/edit
LEAD_RESEARCH_SOURCE_SHEET_URL=https://docs.google.com/spreadsheets/d/REPLACE_ME/edit
LEAD_RESEARCH_DESTINATION_SHEET_URL=https://docs.google.com/spreadsheets/d/REPLACE_ME/edit
OBF_SHEET_URL=https://docs.google.com/spreadsheets/d/REPLACE_ME/edit
ENRICHMENT_SHEET_URL=https://docs.google.com/spreadsheets/d/REPLACE_ME/edit
TASK_MANAGER_URL=https://docs.google.com/spreadsheets/d/REPLACE_ME/edit
COMPARISON_SHEET_URL=https://docs.google.com/spreadsheets/d/REPLACE_ME/edit

# Optional ChatGPT research workflow configuration
SHEET_URL=https://docs.google.com/spreadsheets/d/REPLACE_ME/edit
SHEET_TAB=Messaging
CDP_URL=http://127.0.0.1:9222
CHATGPT_PROFILE_DIR=/absolute/path/to/local/chatgpt-profile
DOC_WEBHOOK_URL=https://example.invalid/webhook
DOC_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Local dashboard: intentionally limited to loopback addresses
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8765
